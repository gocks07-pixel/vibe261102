{
  "name": "hannyomi-adventure",
  "version": "2.1.0",
  "description": "과금없이 즐기는 연희의 RPG 대모험",
  "author": "HC",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:player": "electron-builder --win portable --config electron/build-player.json",
