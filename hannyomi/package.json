{
  "name": "hannyomi-adventure",
  "version": "2.0.0",
  "description": "과금없이 즐기는 연희의 RPG 대모험 (2.0 빌드)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:setup": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.hannyomi.adventure",
    "productName": "RPG Adventure",
    "files": ["index.html", "css/**", "src/**", "electron/**"],
    "directories": { "output": "dist" },
    "win": { "target": "portable" }
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  }
}
