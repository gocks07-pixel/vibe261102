{
  "name": "hannyomi-adventure",
  "version": "1.7.9",
  "description": "한요미의 대모험 (1.7.9 빌드)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:setup": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.hannyomi.adventure",
    "productName": "Hannyomi",
    "files": ["index.html", "css/**", "src/**", "electron/**"],
    "directories": { "output": "dist" },
    "win": { "target": "portable" }
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  }
}
